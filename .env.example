# Environment variables for Caregivers Nearby SEO CMS

# PostgreSQL (Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Seed / roles
# Developer Super Admin (keep with the developer team)
SUPERADMIN_EMAIL="superadmin@caregiversnearby.com"
SUPERADMIN_PASSWORD="replace-me"

# Client Admin (password is not overwritten on re-seed if user already exists)
CLIENT_ADMIN_EMAIL="admin@caregiversnearby.com"
CLIENT_ADMIN_PASSWORD="replace-me"

# Contact forms
RESEND_API_KEY=""
FROM_EMAIL=""
CONTACT_RECEIVER_EMAIL=""

# Image uploads (Vercel Blob)
# Create under Vercel → Storage → Blob, then paste token here + in Vercel env
BLOB_READ_WRITE_TOKEN=""
