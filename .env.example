# Environment variables for Caregivers Nearby SEO CMS

# PostgreSQL (Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Seed / roles
# Developer Super Admin (keep these credentials with the developer team)
SUPERADMIN_EMAIL="dev@caregiversnearby.com"
SUPERADMIN_PASSWORD="SuperAdminChangeMe!"

# Optional client Admin (can create SEO users)
CLIENT_ADMIN_EMAIL=""
CLIENT_ADMIN_PASSWORD="AdminChangeMe123!"

# Legacy aliases still accepted by seed as Super Admin fallbacks
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Contact forms
RESEND_API_KEY=""
FROM_EMAIL=""
CONTACT_RECEIVER_EMAIL=""

# Image uploads (Vercel Blob)
# Create under Vercel → Storage → Blob, then paste token here + in Vercel env
BLOB_READ_WRITE_TOKEN=""
